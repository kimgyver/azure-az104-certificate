// 사용자가 어떤 권한을 가졌든 상관없이, VM을 만들 때 Standard_D2s_v3 크기가 아니면 무조건 생성을 거부(Deny)하겠다"는 정책 - 리소스이 규칙
// policyRule, if, then, effect
{
  "properties": {
    "displayName": "허용된 가상 머신 크기 규정",
    "mode": "Indexed",
    "policyRule": {
      "if": {
        "allOf": [
          { "field": "type", "equals": "Microsoft.Compute/virtualMachines" },
          {
            "field": "Microsoft.Compute/virtualMachines/sku.name",
            "notEquals": "Standard_D2s_v3"
          }
        ]
      },
      "then": {
        "effect": "deny"
      }
    }
  }
}
